{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadWorkSnapshot": {
      "description": "A bounded snapshot of work owned by one root thread.",
      "properties": {
        "activeRootTurns": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "closed": {
          "type": "boolean"
        },
        "outputForwardingObserved": {
          "type": "boolean"
        },
        "outstandingWork": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "pendingNotifications": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "pendingTerminalOutputs": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "quiescent": {
          "type": "boolean"
        },
        "revision": {
          "description": "Opaque coordinator-incarnation and revision token. Pass it back unchanged to guard close.",
          "type": "string"
        },
        "runningFiniteWork": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "activeRootTurns",
        "closed",
        "outputForwardingObserved",
        "outstandingWork",
        "pendingNotifications",
        "pendingTerminalOutputs",
        "quiescent",
        "revision",
        "runningFiniteWork"
      ],
      "type": "object"
    }
  },
  "description": "Lifecycle snapshot published when observed root work changes.",
  "properties": {
    "snapshot": {
      "$ref": "#/definitions/ThreadWorkSnapshot"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "snapshot",
    "threadId"
  ],
  "title": "ThreadWorkUpdatedNotification",
  "type": "object"
}